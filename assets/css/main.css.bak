/* --- content-engine v3: hero / section images / tldr / readable bodies --- */
.pseo-page .hero-img,
.pseo-page .section-img { margin: 1rem 0; }
.pseo-page .hero-img img { width: 100%; height: auto; border-radius: var(--radius); display: block; }
.pseo-page .section-img img { max-width: 320px; width: 100%; height: auto; border-radius: var(--radius); display: block; }
.pseo-page figure { margin: 1rem 0; }
.pseo-page figcaption { font-size: 0.85rem; color: var(--muted); margin-top: 0.35rem; }
.pseo-page .tldr { background: var(--soft); border-left: 4px solid var(--accent); padding: 0.85rem 1rem; border-radius: var(--radius); margin: 1rem 0; }
.pseo-page section p { margin: 0 0 0.8rem; }
.pseo-page section ul, .pseo-page section ol { margin: 0 0 0.9rem 1.2rem; }
.pseo-page section li { margin: 0.25rem 0; }
.pseo-page table { border-collapse: collapse; width: 100%; margin: 0.9rem 0; font-size: 0.95rem; }
.pseo-page th, .pseo-page td { border: 1px solid var(--line); padding: 0.5rem 0.7rem; text-align: left; }
.pseo-page th { background: var(--soft); }

:root {
  /* RN design tokens — light editorial theme */
  --rn-bg: #F6F1E9;
  --rn-surface: #FFFFFF;
  --rn-ink: #211C17;
  --rn-ink-soft: #5B5248;
  --rn-line: #E4DBCE;
  --rn-accent: #2E3A59;
  --rn-accent-hover: #1E2740;
  --rn-gold: #B08A4F;
  --rn-trust: #3E6B57;
  --rn-warn: #A64B3A;
  /* legacy aliases — map old names to new tokens */
  --ink: var(--rn-ink);
  --muted: var(--rn-ink-soft);
  --line: var(--rn-line);
  --paper: var(--rn-bg);
  --soft: rgba(44, 58, 89, 0.06);
  --panel: var(--rn-surface);
  --accent: var(--rn-accent);
  --accent-dark: var(--rn-accent);
  --gold: var(--rn-gold);
  --lav: var(--rn-accent);
  --danger: var(--rn-warn);
  --radius: 12px;
  --serif: "Fraunces", "Newsreader", Georgia, "Times New Roman", serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--rn-ink);
  background: var(--rn-bg);
  background-image: radial-gradient(ellipse at 0% 0%, rgba(176, 138, 79, 0.07) 0%, transparent 60%),
                    radial-gradient(ellipse at 100% 100%, rgba(62, 107, 87, 0.05) 0%, transparent 50%);
  line-height: 1.6;
}

a {
  color: var(--rn-accent);
  text-decoration: none;
}

a:hover {
  color: var(--rn-accent-hover);
  text-decoration: underline;
}

.site-footer {
  max-width: 1120px;
  margin: 0 auto;
  padding: 18px 20px;
}

/* Sticky header wrapper — full-width sticky, inner constrained */
.site-header-wrap {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(246, 241, 233, 0.88);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(228, 219, 206, 0.7);
}

.site-header {
  max-width: 1120px;
  margin: 0 auto;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  color: var(--ink);
  font-family: var(--serif);
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.main-nav {
  display: flex;
  gap: 18px;
  align-items: center;
  font-size: 0.95rem;
}

.hero,
.band,
.content {
  max-width: 1120px;
  margin: 0 auto;
  padding: 56px 20px;
}

.hero {
  display: grid;
  min-height: 420px;
  align-items: center;
  border-bottom: 1px solid var(--line);
}

.eyebrow,
.card-kicker {
  margin: 0 0 12px;
  color: var(--rn-gold);
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: "Newsreader", Georgia, "Times New Roman", serif;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: 0;
}

h1 {
  max-width: 820px;
  font-size: clamp(2.25rem, 5vw, 4.5rem);
}

h2 {
  margin-top: 36px;
  font-size: 1.55rem;
}

h3 {
  font-size: 1.1rem;
}

.lede {
  max-width: 720px;
  color: var(--muted);
  font-size: 1.15rem;
}

.author-byline {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 0.92rem;
}

.hero-actions,
.related-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 24px;
}

.hero-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  margin: 18px 0 20px;
}

.hero-cta span {
  max-width: 520px;
  color: var(--muted);
  font-size: 0.92rem;
}

.emotion-prompt {
  margin: 20px 0;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(216, 176, 74, 0.08);
}

.emotion-prompt h2 {
  margin-top: 0;
}

.emotion-prompt label {
  display: grid;
  gap: 6px;
  margin: 12px 0;
  color: var(--muted);
  font-weight: 700;
}

.emotion-prompt input {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 11px 12px;
  color: var(--ink);
  background: var(--panel);
  font: inherit;
}

.intent-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 28px;
  max-width: 920px;
}

.intent-strip a {
  display: grid;
  gap: 4px;
  min-height: 82px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 12px;
  color: var(--ink);
  background: var(--panel);
}

.intent-strip a:hover {
  border-color: var(--accent);
  text-decoration: none;
}

.intent-strip span {
  color: var(--gold);
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.intent-strip strong {
  font-size: 0.94rem;
  line-height: 1.25;
}

.button {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--accent);
  border-radius: var(--radius);
  padding: 10px 16px;
  font-weight: 800;
}

.button.primary {
  color: #FFFFFF;
  background: var(--rn-accent);
  border-color: var(--rn-accent);
}

.button.primary:hover {
  background: var(--rn-accent-hover);
  border-color: var(--rn-accent-hover);
  text-decoration: none;
}

.button.secondary {
  color: var(--rn-accent);
  background: transparent;
  border-color: var(--rn-accent);
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 18px;
}

.section-heading h2 {
  margin-top: 0;
}

.section-heading p {
  max-width: 520px;
  margin: 0;
  color: var(--muted);
}

.muted {
  background: var(--soft);
  max-width: none;
}

.muted > * {
  max-width: 1080px;
  margin-left: auto;
  margin-right: auto;
}

.grid {
  display: grid;
  gap: 16px;
}

.grid.three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.card,
.tool-panel,
.summary-panel,
.cta-panel,
.affiliate-note {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--panel);
}

.card {
  display: block;
  padding: 20px;
}

.card p,
.list-row em,
.summary-panel span,
.affiliate-note p,
.site-footer {
  color: var(--muted);
}

.list {
  display: grid;
  gap: 8px;
}

.list-row {
  display: grid;
  grid-template-columns: 140px 1fr 100px;
  gap: 12px;
  align-items: center;
  border-bottom: 1px solid var(--line);
  padding: 14px 0;
  color: var(--ink);
}

.content {
  max-width: 880px;
}

.summary-panel {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin: 28px 0;
  overflow: hidden;
}

.summary-panel div {
  padding: 16px;
  border-right: 1px solid var(--line);
}

.summary-panel div:last-child {
  border-right: 0;
}

.summary-panel span,
.summary-panel strong {
  display: block;
}

.summary-panel strong {
  margin-top: 4px;
  font-size: 0.95rem;
}

.affiliate-note,
.cta-panel {
  margin: 24px 0;
  padding: 18px;
}

.checklist {
  padding-left: 20px;
}

.checklist li + li {
  margin-top: 8px;
}

.related-links a {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 8px 10px;
  font-size: 0.9rem;
}

.tool-panel {
  display: grid;
  gap: 16px;
  margin: 28px 0;
  padding: 20px;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

label {
  display: grid;
  gap: 6px;
  color: var(--muted);
  font-weight: 700;
}

select,
input {
  width: 100%;
  min-height: 42px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 8px 10px;
  color: var(--ink);
  background: var(--panel);
  font: inherit;
}

.tool-result {
  border-left: 4px solid var(--accent);
  background: var(--soft);
  padding: 16px;
}

.tool-result .result-main {
  margin: 0;
}

.tool-result .result-soft {
  margin: 10px 0 0;
  font-size: 0.95rem;
}

.tool-result .result-questions {
  margin: 12px 0 0;
  padding-left: 1.2rem;
}

.tool-result .result-questions li {
  margin: 0 0 10px;
  display: flex;
  gap: 10px;
  align-items: start;
  justify-content: space-between;
}

.tool-result .copy-btn {
  flex: none;
  font-size: 0.8rem;
  padding: 2px 10px;
  border: 1px solid var(--accent);
  background: transparent;
  color: var(--accent);
  border-radius: 4px;
  cursor: pointer;
}

.tool-result .copy-btn:hover {
  background: var(--accent);
  color: #fff;
}

.tool-result .result-hint {
  margin: 8px 0 0;
  font-size: 0.85rem;
  opacity: 0.7;
}

.soft-cta {
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid currentColor;
}

.soft-cta:hover {
  opacity: 0.8;
}

.faq details {
  border-bottom: 1px solid var(--line);
  padding: 12px 0;
}

.faq summary {
  font-weight: 600;
  cursor: pointer;
}

.faq details p {
  margin: 8px 0 0;
}

.last-updated {
  margin-top: 24px;
  font-size: 0.85rem;
  opacity: 0.65;
}

.sky-today {
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--soft);
  padding: 16px 20px;
  margin: 24px 0;
}

.sky-moon {
  display: flex;
  align-items: center;
  gap: 14px;
}

.sky-emoji {
  font-size: 2rem;
  line-height: 1;
}

.sky-moon strong {
  display: block;
}

.sky-sub {
  font-size: 0.9rem;
  opacity: 0.75;
}

.sky-note {
  margin: 10px 0 0;
  font-size: 0.92rem;
}

.site-footer {
  border-top: 1px solid var(--line);
}

.site-footer nav {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.footer-guides {
  align-items: center;
  margin-bottom: 14px;
}

.footer-guides strong {
  margin-right: 4px;
}

@media (max-width: 760px) {
  .site-header,
  .section-heading {
    align-items: start;
    flex-direction: column;
  }

  .main-nav {
    flex-wrap: wrap;
  }

  .grid.three,
  .intent-strip,
  .summary-panel,
  .tool-grid {
    grid-template-columns: 1fr;
  }

  .summary-panel div {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .list-row {
    grid-template-columns: 1fr;
  }
}

/* --- card transitions --- */
.card,
.intent-strip a {
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.card:hover,
.intent-strip a:hover {
  transform: translateY(-3px);
  border-color: var(--rn-gold);
  box-shadow: 0 8px 20px rgba(33, 28, 23, 0.1);
}

.list-row:hover {
  background: rgba(44, 58, 89, 0.04);
}

/* ===== Phase 1B: Homepage as interactive tarot product ===== */

/* --- Layout bands --- */
.rn-band {
  padding: 56px 20px;
}
.rn-band--alt {
  background: var(--rn-surface);
  border-top: 1px solid var(--rn-line);
  border-bottom: 1px solid var(--rn-line);
}
.rn-band__inner {
  max-width: 1120px;
  margin: 0 auto;
}
.rn-section-title {
  font-family: var(--serif);
  font-size: 1.55rem;
  font-weight: 600;
  color: var(--rn-ink);
  margin: 0 0 6px;
}
.rn-section-sub {
  color: var(--rn-ink-soft);
  margin: 0 0 28px;
  font-size: 1rem;
}

/* --- Hero --- */
.rn-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
  max-width: 1120px;
  margin: 0 auto;
  padding: 56px 20px 48px;
  min-height: 480px;
}
.rn-hero__h1 {
  font-family: var(--serif);
  font-size: clamp(2rem, 4vw, 3.4rem);
  font-weight: 600;
  line-height: 1.15;
  color: var(--rn-ink);
  margin: 0 0 16px;
  max-width: 560px;
}
.rn-hero__sub {
  font-size: 1.1rem;
  color: var(--rn-ink-soft);
  margin: 0 0 24px;
  max-width: 480px;
}

/* --- Quick question chips --- */
.rn-hero__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 4px;
}
.rn-chip {
  border: 1px solid var(--rn-line);
  border-radius: 100px;
  background: var(--rn-surface);
  color: var(--rn-ink);
  font: inherit;
  font-size: 0.88rem;
  padding: 6px 14px;
  cursor: pointer;
  transition: border-color 0.12s ease, background 0.12s ease;
  min-height: 36px;
}
.rn-chip:hover,
.rn-chip.active {
  border-color: var(--rn-accent);
  background: rgba(46, 58, 89, 0.06);
}

/* --- Hero interactive panel --- */
.rn-hero__panel {
  background: var(--rn-surface);
  border: 1px solid var(--rn-line);
  border-radius: 16px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.rn-pull-prompt__text {
  font-family: var(--serif);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--rn-ink);
  margin: 0 0 10px;
}
.rn-pull-input {
  width: 100%;
  border: 1px solid var(--rn-line);
  border-radius: 8px;
  padding: 10px 12px;
  font: inherit;
  font-size: 0.95rem;
  color: var(--rn-ink);
  background: var(--rn-bg);
  margin-bottom: 12px;
  min-height: 42px;
  box-sizing: border-box;
}
.rn-pull-input:focus {
  outline: 2px solid var(--rn-accent);
  outline-offset: 1px;
}
.rn-pull-btn {
  width: 100%;
  min-height: 48px;
  background: var(--rn-accent);
  color: #fff;
  border: none;
  border-radius: 8px;
  font: inherit;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.12s ease;
}
.rn-pull-btn:hover {
  background: var(--rn-accent-hover);
}
.rn-pull-note {
  font-size: 0.82rem;
  color: var(--rn-ink-soft);
  margin: 4px 0 0;
  text-align: center;
}

/* --- Flip-card deck --- */
.rn-cards {
  display: flex;
  gap: 10px;
  justify-content: center;
  perspective: 900px;
}
.rn-card-slot {
  flex: 0 0 80px;
  width: 80px;
  height: 130px;
}
.rn-card-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 8px;
}
.rn-card-slot.flipped .rn-card-inner {
  transform: rotateY(180deg);
}
.rn-card-face {
  position: absolute;
  inset: 0;
  border-radius: 8px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  overflow: hidden;
  box-shadow: 0 3px 10px rgba(33, 28, 23, 0.16);
}
.rn-card-back-face {
  background: #2E3A59;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rn-card-back-face::after {
  content: '';
  display: block;
  width: 58px;
  height: 95px;
  border: 1px solid rgba(176, 138, 79, 0.6);
  border-radius: 5px;
  box-shadow: inset 0 0 0 7px rgba(176, 138, 79, 0.12);
}
.rn-card-front-face {
  transform: rotateY(180deg);
  background: #fff;
}
.rn-card-front-face img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* --- Pull result --- */
.rn-pull-result {
  animation: rn-fadein 0.18s ease both;
}
.rn-pull-result .card-labels {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 14px;
}
.rn-pull-result .card-label {
  text-align: center;
  animation: rn-fadein 0.25s ease both;
}
.rn-pull-result .card-label .card-pos {
  font-size: 0.68rem;
  color: var(--rn-gold);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  display: block;
  margin-bottom: 3px;
}
.rn-pull-result .card-label .card-name {
  font-family: "Newsreader", Georgia, serif;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--rn-ink);
  display: block;
  margin-bottom: 4px;
}
.rn-pull-result .card-label .card-hint {
  font-size: 0.78rem;
  color: var(--rn-ink-soft);
  line-height: 1.4;
}
.rn-pull-result .result-cta-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 14px;
}
.rn-pull-result .cta-secondary {
  display: block;
  text-align: center;
  font-size: 0.9rem;
  color: var(--rn-accent);
  padding: 10px;
  border: 1px solid var(--rn-accent);
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.12s;
}
.rn-pull-result .cta-secondary:hover {
  background: rgba(46, 58, 89, 0.06);
  text-decoration: none;
}
.rn-pull-result .cta-fiverr {
  display: block;
  text-align: center;
  font-size: 0.88rem;
  color: var(--rn-ink-soft);
  padding: 10px;
  border: 1px solid var(--rn-line);
  border-radius: 8px;
  text-decoration: none;
}
.rn-pull-result .cta-fiverr:hover {
  border-color: var(--rn-accent);
  color: var(--rn-accent);
  text-decoration: none;
}
.rn-pull-reset {
  background: none;
  border: none;
  font: inherit;
  font-size: 0.82rem;
  color: var(--rn-ink-soft);
  cursor: pointer;
  text-align: center;
  text-decoration: underline;
  padding: 0;
  margin-top: 2px;
}

@keyframes rn-fadein {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Tabler icon colour override */
.rn-tool-card__icon img,
.rn-flag__icon img {
  filter: invert(18%) sepia(20%) saturate(800%) hue-rotate(189deg) brightness(90%) contrast(95%);
  /* approximates --rn-accent #2E3A59 */
}
.rn-flag__icon img {
  filter: invert(28%) sepia(40%) saturate(600%) hue-rotate(325deg) brightness(85%) contrast(100%);
  /* approximates --rn-warn #A64B3A */
}


/* --- Tool grid --- */
.rn-tool-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.rn-tool-card {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  background: var(--rn-bg);
  border: 1px solid var(--rn-line);
  border-radius: 12px;
  padding: 20px;
  text-decoration: none;
  color: var(--rn-ink);
  transition: border-color 0.12s ease, box-shadow 0.12s ease, transform 0.12s ease;
}
.rn-tool-card:hover {
  border-color: var(--rn-accent);
  box-shadow: 0 6px 18px rgba(33, 28, 23, 0.08);
  transform: translateY(-2px);
  text-decoration: none;
}
.rn-tool-card__icon {
  flex: 0 0 40px;
  width: 40px;
  height: 40px;
}
.rn-tool-card__icon svg {
  width: 40px;
  height: 40px;
}
.rn-tool-card strong {
  display: block;
  font-size: 0.97rem;
  margin-bottom: 4px;
}
.rn-tool-card p {
  margin: 0 0 8px;
  font-size: 0.9rem;
  color: var(--rn-ink-soft);
}
.rn-tool-card__badge {
  font-size: 0.75rem;
  color: var(--rn-trust);
  font-weight: 600;
  letter-spacing: 0.03em;
}

/* --- Anti-scam trust block --- */
.rn-trust-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
}
.rn-trust-block__copy h2 {
  font-family: var(--serif);
  font-size: 1.55rem;
  font-weight: 600;
  margin: 8px 0 12px;
  color: var(--rn-ink);
}
.rn-trust-block__sub {
  color: var(--rn-ink-soft);
  margin: 0 0 16px;
}
.rn-trust-link {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--rn-trust);
  text-decoration: none;
  border-bottom: 1px solid currentColor;
}
.rn-trust-link:hover {
  opacity: 0.8;
  text-decoration: none;
}
.rn-trust-block__flags {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.rn-flag {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  background: rgba(166, 75, 58, 0.05);
  border: 1px solid rgba(166, 75, 58, 0.15);
  border-radius: 10px;
  padding: 14px;
}
.rn-flag__icon {
  flex: 0 0 24px;
  margin-top: 1px;
}
.rn-flag__icon svg {
  width: 24px;
  height: 24px;
  display: block;
}
.rn-flag strong {
  display: block;
  font-size: 0.93rem;
  color: var(--rn-warn);
  margin-bottom: 3px;
}
.rn-flag p {
  margin: 0;
  font-size: 0.88rem;
  color: var(--rn-ink-soft);
  font-style: italic;
}

/* --- Featured guide grid (6 cards max) --- */
.rn-guide-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 20px;
}
.rn-guide-card {
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: var(--rn-bg);
  border: 1px solid var(--rn-line);
  border-radius: 12px;
  padding: 20px;
  text-decoration: none;
  color: var(--rn-ink);
  transition: border-color 0.12s ease, box-shadow 0.12s ease, transform 0.12s ease;
}
.rn-guide-card:hover {
  border-color: var(--rn-accent);
  box-shadow: 0 6px 18px rgba(33, 28, 23, 0.08);
  transform: translateY(-2px);
  text-decoration: none;
}
.rn-guide-card__kicker {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--rn-gold);
  text-transform: uppercase;
  letter-spacing: 0.07em;
}
.rn-guide-card strong {
  font-size: 0.97rem;
  line-height: 1.3;
}
.rn-guide-card p {
  margin: 0;
  font-size: 0.88rem;
  color: var(--rn-ink-soft);
}
.rn-guides-more {
  font-size: 0.9rem;
  color: var(--rn-ink-soft);
  margin: 0;
}
.rn-guides-more a {
  color: var(--rn-accent);
}

/* --- Soft Fiverr CTA block --- */
.rn-soft-cta-block {
  max-width: 620px;
  margin: 0 auto;
  text-align: center;
}
.rn-soft-cta-block__label {
  font-family: var(--serif);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--rn-ink);
  margin: 0 0 8px;
}
.rn-soft-cta-block p {
  color: var(--rn-ink-soft);
  margin: 0 0 20px;
}
.rn-soft-cta-block__note {
  font-size: 0.8rem;
  color: var(--rn-ink-soft);
  margin: 12px 0 0;
}

/* --- Shared button tokens --- */
.rn-btn {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  padding: 10px 22px;
  font: inherit;
  font-weight: 600;
  font-size: 0.97rem;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.12s ease;
}
.rn-btn--primary {
  background: var(--rn-accent);
  color: #fff;
  border: 1px solid var(--rn-accent);
}
.rn-btn--primary:hover {
  background: var(--rn-accent-hover);
  border-color: var(--rn-accent-hover);
  text-decoration: none;
  color: #fff;
}
.rn-btn--ghost {
  background: transparent;
  color: var(--rn-accent);
  border: 1px solid var(--rn-accent);
}
.rn-btn--ghost:hover {
  background: rgba(46, 58, 89, 0.06);
  text-decoration: none;
}

/* --- Homepage responsive --- */
@media (max-width: 860px) {
  .rn-hero {
    grid-template-columns: 1fr;
    gap: 28px;
    padding-top: 36px;
  }
  .rn-hero__panel {
    order: 2;
  }
  .rn-hero__text {
    order: 1;
  }
  .rn-trust-block {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .rn-guide-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .rn-tool-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 560px) {
  .rn-guide-grid {
    grid-template-columns: 1fr;
  }
  .rn-cards {
    gap: 6px;
  }
  .rn-card-slot {
    flex: 0 0 66px;
    width: 66px;
    height: 107px;
  }
}

/* ===== Phase 1C additions ===== */

/* --- Hero background: CHANI/Moonlight inspired --- */
.rn-hero-wrap {
  background: #1C2235;
  background-image:
    radial-gradient(ellipse 80% 60% at 50% -10%, rgba(176, 138, 79, 0.18) 0%, transparent 70%),
    radial-gradient(circle at 85% 40%, rgba(62, 107, 87, 0.12) 0%, transparent 45%);
  position: relative;
  overflow: hidden;
}
.rn-hero-wrap::before {
  content: '';
  position: absolute;
  top: -60px;
  right: 5%;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  border: 1px solid rgba(176, 138, 79, 0.15);
  pointer-events: none;
}
.rn-hero-wrap::after {
  content: '';
  position: absolute;
  top: 20px;
  right: calc(5% + 40px);
  width: 240px;
  height: 240px;
  border-radius: 50%;
  border: 1px solid rgba(176, 138, 79, 0.08);
  pointer-events: none;
}
.rn-hero-wrap .rn-hero {
  padding-top: 64px;
  padding-bottom: 64px;
}
.rn-hero-wrap .rn-hero__h1 {
  color: #F0EBE1;
}
.rn-hero-wrap .rn-hero__sub {
  color: rgba(240, 235, 225, 0.72);
}
.rn-hero-wrap .eyebrow {
  color: var(--rn-gold);
}
.rn-hero-wrap .rn-hero__panel {
  background: rgba(246, 241, 233, 0.97);
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.28);
}

/* --- Chips inside panel --- */
.rn-pull-prompt__sub {
  font-size: 0.85rem;
  color: var(--rn-ink-soft);
  margin: -4px 0 14px;
}
.rn-pull-chips-panel {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-bottom: 16px;
}
.rn-chip--panel {
  display: block;
  width: 100%;
  text-align: left;
  border: 1px solid var(--rn-line);
  border-radius: 8px;
  background: var(--rn-bg);
  color: var(--rn-ink);
  font: inherit;
  font-size: 0.9rem;
  padding: 9px 14px;
  cursor: pointer;
  transition: border-color 0.12s ease, background 0.12s ease;
  min-height: 40px;
}
.rn-chip--panel:hover {
  border-color: var(--rn-accent);
  background: rgba(46, 58, 89, 0.04);
}
.rn-chip--panel.active {
  border-color: var(--rn-accent);
  background: rgba(46, 58, 89, 0.08);
  font-weight: 600;
}

/* --- Prompt text — no input now --- */
.rn-pull-prompt__text {
  font-family: "Newsreader", Georgia, serif;
  font-size: 1rem;
  font-weight: 600;
  color: var(--rn-ink);
  margin: 0 0 4px;
}

/* --- Content / pseo-page layout fix --- */
.content.pseo-page {
  max-width: 760px;
  margin: 0 auto;
  padding: 40px 20px 60px;
}
.content.pseo-page h1 {
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  margin-bottom: 14px;
}
.content.pseo-page .lede {
  font-size: 1.05rem;
  color: var(--rn-ink-soft);
  margin-bottom: 20px;
}
.content.pseo-page .summary-panel {
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid var(--rn-line);
  background: var(--rn-surface);
  margin: 24px 0;
}
.content.pseo-page .affiliate-note {
  background: rgba(46, 58, 89, 0.04);
  border: 1px solid rgba(46, 58, 89, 0.12);
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 0.88rem;
}
.content.pseo-page .cta-panel {
  background: var(--rn-surface);
  border: 1px solid var(--rn-line);
  border-radius: 10px;
  padding: 18px;
}
.content.pseo-page section h2 {
  margin-top: 32px;
  margin-bottom: 10px;
  font-size: 1.3rem;
}
.content.pseo-page .hero-cta {
  margin: 18px 0 22px;
}

@media (max-width: 860px) {
  .rn-hero-wrap::before,
  .rn-hero-wrap::after {
    display: none;
  }
  .rn-pull-chips-panel {
    gap: 6px;
  }
}

/* ===== Phase 1D: Art direction ===== */

/* --- Body: subtle warm wash so it's never pure flat --- */
body {
  background: var(--rn-bg);
  background-image:
    radial-gradient(ellipse 120% 60% at 0% 0%, rgba(176,138,79,0.06) 0%, transparent 55%),
    radial-gradient(ellipse 80% 80% at 100% 100%, rgba(62,107,87,0.05) 0%, transparent 50%);
}

/* --- Section colour palette --- */
.rn-band--cream {
  background: #FAF6EE;
  border-top: 1px solid var(--rn-line);
  border-bottom: 1px solid var(--rn-line);
}
.rn-band--guides {
  background: var(--rn-bg);
}
.rn-band--dark {
  background: #1C2235;
}
/* Dark band text overrides */
.rn-band--dark h2,
.rn-band--dark .rn-trust-block__copy h2 {
  color: #F0EBE1;
}
.rn-band--dark .rn-trust-block__sub {
  color: rgba(240,235,225,0.72);
}
.rn-band--dark .eyebrow {
  color: var(--rn-gold);
}
.rn-band--dark .rn-trust-link {
  color: var(--rn-gold);
  border-bottom-color: var(--rn-gold);
}
.rn-band--dark .rn-flag {
  background: rgba(255,255,255,0.05);
  border-color: rgba(255,255,255,0.1);
}
.rn-band--dark .rn-flag strong {
  color: #e8a090;
}
.rn-band--dark .rn-flag p {
  color: rgba(240,235,225,0.6);
}
.rn-band--dark .rn-flag__num {
  color: var(--rn-gold);
  border-color: rgba(176,138,79,0.35);
}

/* Red flag number badge (replaces icon) */
.rn-flag__num {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--rn-warn);
  color: var(--rn-warn);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.78rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* --- Tarot mat: the card stage surface --- */
.rn-tarot-mat {
  background: #16202E;
  border-radius: 12px;
  border: 1px solid rgba(176,138,79,0.3);
  padding: 20px 16px;
  margin: 14px 0 16px;
  position: relative;
  box-shadow: inset 0 1px 0 rgba(176,138,79,0.15), 0 4px 20px rgba(0,0,0,0.2);
}
.rn-tarot-mat--result {
  margin-bottom: 0;
}
.rn-tarot-mat::before {
  content: '';
  position: absolute;
  inset: 5px;
  border-radius: 8px;
  border: 1px solid rgba(176,138,79,0.1);
  pointer-events: none;
}
.rn-mat-hint {
  text-align: center;
  font-size: 0.78rem;
  color: rgba(176,138,79,0.7);
  margin: 10px 0 0;
  letter-spacing: 0.04em;
}

/* --- Card slots: bigger --- */
.rn-cards {
  display: flex;
  gap: 14px;
  justify-content: center;
}
.rn-card-slot {
  flex: 0 0 110px;
  width: 110px;
  height: 178px;
}
.rn-card-back-face {
  background: #1E2D4A;
  background-image: radial-gradient(ellipse at 50% 30%, rgba(176,138,79,0.15), transparent 65%);
}
/* Richer card back pattern */
.rn-card-back-face::after {
  content: '';
  display: block;
  width: 80px;
  height: 130px;
  border: 1.5px solid rgba(176,138,79,0.55);
  border-radius: 6px;
  background:
    radial-gradient(circle at 50% 50%, rgba(176,138,79,0.18) 0%, transparent 60%),
    repeating-linear-gradient(45deg, transparent, transparent 8px, rgba(176,138,79,0.04) 8px, rgba(176,138,79,0.04) 9px);
}

/* Override smaller breakpoint cards inside mat */
.rn-tarot-mat .rn-card-slot {
  flex: 0 0 110px;
  width: 110px;
  height: 178px;
}

/* --- Hero panel: taller, more product-like --- */
.rn-hero__panel {
  min-height: 500px;
}

/* --- Editorial buyer guides --- */
.rn-guides-header {
  margin-bottom: 32px;
}
.rn-guides-header h2 {
  font-family: "Newsreader", Georgia, serif;
  font-size: clamp(1.4rem, 2.8vw, 2rem);
  font-weight: 600;
  color: var(--rn-ink);
  margin: 0 0 8px;
  max-width: 680px;
}
.rn-guides-header p {
  color: var(--rn-ink-soft);
  margin: 0;
}
.rn-guides-editorial {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}
.rn-guide-featured {
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: #1C2235;
  border-radius: 14px;
  padding: 28px 24px;
  text-decoration: none;
  color: #F0EBE1;
  transition: box-shadow 0.15s ease;
}
.rn-guide-featured:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,0.22);
  text-decoration: none;
  color: #F0EBE1;
}
.rn-guide-featured__label {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--rn-gold);
}
.rn-guide-featured__title {
  font-family: "Newsreader", Georgia, serif;
  font-size: 1.35rem;
  font-weight: 600;
  line-height: 1.2;
}
.rn-guide-featured p {
  font-size: 0.92rem;
  color: rgba(240,235,225,0.75);
  margin: 0;
  flex: 1;
}
.rn-guide-featured__cta {
  font-size: 0.85rem;
  color: var(--rn-gold);
  margin-top: 4px;
}
.rn-guides-stack {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.rn-guide-row {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  padding: 14px 0;
  border-bottom: 1px solid var(--rn-line);
  text-decoration: none;
  color: var(--rn-ink);
  transition: opacity 0.12s;
}
.rn-guide-row:hover {
  opacity: 0.75;
  text-decoration: none;
  color: var(--rn-ink);
}
.rn-guide-row__num {
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--rn-gold);
  letter-spacing: 0.06em;
  padding-top: 3px;
  flex: 0 0 22px;
  font-variant-numeric: tabular-nums;
}
.rn-guide-row strong {
  display: block;
  font-size: 0.95rem;
  margin-bottom: 3px;
}
.rn-guide-row p {
  margin: 0;
  font-size: 0.85rem;
  color: var(--rn-ink-soft);
}
.rn-guides-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  padding-top: 20px;
  border-top: 1px solid var(--rn-line);
}
.rn-guides-strip a {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 16px;
  background: var(--rn-surface);
  border: 1px solid var(--rn-line);
  border-radius: 10px;
  text-decoration: none;
  color: var(--rn-ink);
  font-size: 0.9rem;
  transition: border-color 0.12s ease;
}
.rn-guides-strip a:hover {
  border-color: var(--rn-accent);
  text-decoration: none;
}
.rn-guides-strip span {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--rn-ink-soft);
}

/* --- Footer redesign --- */
.rn-footer {
  background: #131820;
  color: rgba(240,235,225,0.85);
  margin-top: 0;
}
.rn-footer__inner {
  max-width: 1120px;
  margin: 0 auto;
  padding: 56px 20px 40px;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
}
.rn-footer__tagline {
  font-family: "Newsreader", Georgia, serif;
  font-size: 1.05rem;
  color: rgba(240,235,225,0.9);
  line-height: 1.5;
  margin: 0 0 10px;
}
.rn-footer__sub {
  font-size: 0.8rem;
  color: rgba(176,138,79,0.75);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0;
}
.rn-footer__col {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.rn-footer__col strong {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgba(240,235,225,0.5);
  margin-bottom: 2px;
}
.rn-footer__col a {
  font-size: 0.88rem;
  color: rgba(240,235,225,0.75);
  text-decoration: none;
}
.rn-footer__col a:hover {
  color: var(--rn-gold);
  text-decoration: none;
}
.rn-footer__bottom {
  max-width: 1120px;
  margin: 0 auto;
  padding: 20px 20px 28px;
  border-top: 1px solid rgba(255,255,255,0.07);
  display: flex;
  align-items: center;
  gap: 16px;
}
.rn-footer__moon {
  flex: 0 0 32px;
  opacity: 0.6;
}
.rn-footer__bottom p {
  margin: 0;
  font-size: 0.78rem;
  color: rgba(240,235,225,0.4);
  line-height: 1.5;
}
.rn-footer__bottom p + p {
  margin-left: auto;
  white-space: nowrap;
}

/* --- Responsive: guides editorial and footer --- */
@media (max-width: 900px) {
  .rn-guides-editorial {
    grid-template-columns: 1fr;
  }
  .rn-guide-featured {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rn-guide-featured__title {
    font-size: 1.1rem;
  }
  .rn-footer__inner {
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .rn-footer__brand {
    grid-column: 1 / -1;
  }
}
@media (max-width: 560px) {
  .rn-tarot-mat .rn-card-slot,
  .rn-card-slot {
    flex: 0 0 84px;
    width: 84px;
    height: 136px;
  }
  .rn-guide-featured {
    flex-direction: column;
  }
  .rn-guides-strip {
    grid-template-columns: 1fr;
  }
  .rn-footer__inner {
    grid-template-columns: 1fr;
    gap: 24px;
    padding-top: 36px;
  }
  .rn-footer__bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .rn-footer__bottom p + p {
    margin-left: 0;
  }
}
